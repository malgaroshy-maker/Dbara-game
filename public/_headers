# Cloudflare Pages headers.
#
# The service worker must never be served from cache: a player who opened the
# game once would otherwise keep the build they first saw and never receive an
# update, which is the most common way a PWA strands its users.
/sw.js
  Cache-Control: no-cache

# The manifest changes rarely but must not outlive a rename of the icons.
/manifest.webmanifest
  Cache-Control: max-age=3600

# Hashed build assets are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
